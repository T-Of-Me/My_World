<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Geminai AI</title>
    <link href="/css/tailwind.css" rel="stylesheet">
    <script src="/js/alpine.js" defer></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 via-black to-gray-900">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-5xl font-bold mb-2 glow-text">Geminai AI</h1>
            <p class="text-gray-400 text-lg">Image Generation Platform</p>
        </div>
        
        <div class="card">
            <h2 class="text-2xl font-bold mb-6 text-center">Login</h2>
            
            <% if (error) { %>
                <div class="mb-4 p-4 bg-red-900/30 border border-red-700 rounded-lg text-red-300">
                    <%= error %>
                </div>
            <% } %>
            
            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Username</label>
                    <input 
                        type="text" 
                        name="username" 
                        required 
                        class="input-field"
                        placeholder="Enter your username"
                    >
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Password</label>
                    <input 
                        type="password" 
                        name="password" 
                        required 
                        class="input-field"
                        placeholder="Enter your password"
                    >
                </div>
                
                <button type="submit" class="btn-primary w-full">
                    Login
                </button>
            </form>
            
            <div class="mt-6 text-center">
                <p class="text-gray-400">
                    Don't have an account? 
                    <a href="/register" class="text-cyan-400 hover:text-cyan-300 transition-colors">Register here</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>

