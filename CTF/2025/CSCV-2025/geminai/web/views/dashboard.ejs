<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Geminai AI</title>
    <link href="/css/tailwind.css" rel="stylesheet">
    <script src="/js/alpine.js" defer></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900">
    <!-- Navigation -->
    <nav class="border-b border-gray-800 bg-gray-900/50 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold glow-text">Geminai AI</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-gray-300">Welcome, <span class="text-cyan-400"><%= username %></span></span>
                    <a href="/logout" class="btn-secondary text-sm">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Upload Section -->
        <div class="card mb-8">
            <h2 class="text-2xl font-bold mb-6 glow-text">Generate AI Image</h2>
            
            <div x-data="imageGenerator()" class="space-y-6">
                <!-- Image Upload -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Upload Image</label>
                    <div class="border-2 border-dashed border-gray-700 rounded-lg p-8 text-center hover:border-cyan-500 transition-colors">
                        <div x-show="!selectedImage" class="space-y-4">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                            </svg>
                            <div>
                                <button 
                                    type="button"
                                    @click="$refs.fileInput.click()"
                                    class="btn-secondary"
                                >
                                    Select Image
                                </button>
                                <input type="file" x-ref="fileInput" id="imageInput" accept="image/*" @change="handleFileSelect($event)" class="hidden">
                            </div>
                            <p class="text-sm text-gray-400">PNG, JPG, GIF up to 1MB</p>
                        </div>
                        <div x-show="selectedImage" class="space-y-4">
                            <img :src="selectedImage" alt="Preview" class="max-h-64 mx-auto rounded-lg border border-gray-700">
                            <button 
                                type="button"
                                @click="clearImage()"
                                class="btn-secondary text-sm"
                            >
                                Change Image
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Model Selection -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-4">Select AI Model</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <% if (models && models.length > 0) { 
                            models.forEach(model => { %>
                                <div 
                                    class="model-card"
                                    :class="{ 'active': selectedModel === '<%= model.model_id %>' }"
                                    @click="selectModel('<%= model.model_id %>'%>)"
                                >
                                    <div class="flex items-center justify-between mb-2">
                                        <h3 class="text-lg font-semibold <%= model.available ? 'text-cyan-400' : 'text-gray-500' %>">
                                            <%= model.name %>
                                        </h3>
                                        <% if (model.available) { %>
                                            <span class="px-2 py-1 text-xs bg-green-900/30 text-green-400 rounded border border-green-700">Available</span>
                                        <% } else { %>
                                            <span class="px-2 py-1 text-xs bg-yellow-900/30 text-yellow-400 rounded border border-yellow-700">Coming Soon</span>
                                        <% } %>
                                    </div>
                                    <p class="text-sm text-gray-400">
                                        <% if (model.available) { %>
                                            Ready to generate
                                        <% } else { %>
                                            This model will be available soon
                                        <% } %>
                                    </p>
                                </div>
                            <% }); 
                        } else { %>
                            <p class="text-gray-400">No models available</p>
                        <% } %>
                    </div>
                </div>

                <!-- Generate Button -->
                <div>
                    <button 
                        type="button"
                        @click.prevent="generateImage($event)"
                        :disabled="!selectedImage || isGenerating"
                        class="btn-primary w-full disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                    >
                        <span x-show="!isGenerating" class="flex items-center justify-center gap-2">
                            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                            Generate Image
                        </span>
                        <span x-show="isGenerating" class="flex items-center justify-center gap-2">
                            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Generating...
                        </span>
                    </button>
                </div>

                <!-- Result Display -->
                <div x-show="result" x-transition class="card bg-gray-900/50">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xl font-bold glow-text">Generated Image</h3>
                        <button 
                            @click="result = null; selectedImage = null; document.getElementById('imageInput').value = '';"
                            class="text-gray-400 hover:text-white transition-colors"
                        >
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-400 mb-2">Original</p>
                            <img :src="result ? result.originalImage : ''" alt="Original" class="w-full rounded-lg border border-gray-700">
                        </div>
                        <div>
                            <p class="text-sm text-gray-400 mb-2">Generated</p>
                            <img :src="result ? result.generatedImage : ''" alt="Generated" class="w-full rounded-lg border border-cyan-500">
                        </div>
                    </div>
                    <div class="mt-4 p-4 bg-gray-800/50 rounded-lg">
                        <p class="text-sm text-gray-400">Model: <span class="text-cyan-400" x-text="result ? result.modelName : ''"></span></p>
                    </div>
                </div>

                <!-- Error Display -->
                <div x-show="error" class="p-4 bg-red-900/30 border border-red-700 rounded-lg text-red-300">
                    <p x-text="error"></p>
                </div>
            </div>
        </div>

        <!-- Recent Images -->
        <div class="card" x-ignore>
            <h2 class="text-2xl font-bold mb-6 glow-text">Recent Generations</h2>
            <% if (images && images.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <% images.forEach(image => { %>
                        <div class="bg-gray-800/50 rounded-lg overflow-hidden border border-gray-700">
                            <img src="<%= image.generated_image || image.original_image %>" alt="Generated" class="w-full h-48 object-cover">
                            <div class="p-4">
                                <p class="text-sm text-gray-400">Model: <span class="text-cyan-400"><%= image.model_name || 'Unknown' %></span></p>
                                <p class="text-xs text-gray-500 mt-1"><%= new Date(image.created_at).toLocaleString() %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-gray-400 text-center py-8">No generated images yet. Upload an image and generate your first AI image!</p>
            <% } %>
        </div>
    </main>

    <script>
        function imageGenerator() {
            return {
                selectedImage: null,
                selectedModel: '<%= models && models.find(m => m.model_id === "geminai-o3") ? models.find(m => m.model_id === "geminai-o3").model_id : "" %>', // Default to Geminai O3
                isGenerating: false,
                result: null,
                error: null,

                onPreview: (url) => this.preview = url,
                
                handleFileSelect(event) {
                    const file = event.target.files[0];
                    if (file) {
                        // Only allow image mime types
                        if (!file.type.startsWith('image/')) {
                            this.error = 'Invalid file type.';
                            this.clearImage();
                            return;
                        }

                        this.selectedImage = URL.createObjectURL(file);
                    }
                },
                
                clearImage() {
                    if (this.selectedImage) {
                        URL.revokeObjectURL(this.selectedImage);
                    }

                    this.selectedImage = null;
                    document.getElementById('imageInput').value = '';
                },
                
                selectModel(modelId) {
                    this.selectedModel = modelId;
                    this.error = null;
                },
                
                async generateImage(event) {
                    // Prevent any default form submission or page reload
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    
                    // Also prevent default behavior
                    if (!event) {
                        // If no event passed, create a dummy one
                        const dummyEvent = { preventDefault: () => {}, stopPropagation: () => {} };
                        dummyEvent.preventDefault();
                        dummyEvent.stopPropagation();
                    }
                    
                    if (!this.selectedImage) {
                        this.error = 'Please select an image';
                        return false;
                    }
                    
                    // Ensure default model is set
                    if (!this.selectedModel) {
                        this.selectedModel = '<%= models && models.find(m => m.model_id === "geminai-o3") ? models.find(m => m.model_id === "geminai-o3").model_id : "" %>';
                    }
                    
                    this.isGenerating = true;
                    this.error = null;
                    this.result = null;
                    
                    try {
                        const formData = new FormData();
                        const fileInput = this.$refs.fileInput;
                        if (!fileInput || !fileInput.files[0]) {
                            this.error = 'Please select an image file';
                            this.isGenerating = false;
                            return false;
                        }
                        formData.append('image', fileInput.files[0]);
                        formData.append('modelId', this.selectedModel);
                        formData.append('userId', '<%= userId %>');
                        
                        const response = await fetch('/generate', {
                            method: 'POST',
                            body: formData
                        });
                        
                        const data = await response.json();
                        
                        if (response.ok && data.success) {
                            this.result = {
                                originalImage: data.originalImage,
                                generatedImage: data.generatedImage,
                                modelName: data.modelName
                            };
                            // Scroll to result section
                            this.$nextTick(() => {
                                const resultSection = document.querySelector('[x-show="result"]');
                                if (resultSection) {
                                    resultSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                }
                            });
                        } else {
                            this.error = data.error || 'An error occurred during generation';
                        }
                    } catch (error) {
                        this.error = 'Network error. Please try again.';
                        console.error('Generation error:', error);
                    } finally {
                        this.isGenerating = false;
                    }
                    return false;
                }
            }
        }
    </script>
</body>
</html>

