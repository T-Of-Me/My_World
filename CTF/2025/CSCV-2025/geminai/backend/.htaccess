RewriteEngine On

# Disable directory listing
Options -Indexes

# Block /assets/** access
RewriteRule ^assets(/.*)?$ - [F,L]

# [O]range + [T]sai = OT?
# ~ OT isn't fun (┬┬﹏┬┬)
RewriteCond %{THE_REQUEST} (%25|%2e|%2f|%3f|\.\.) [NC]
RewriteRule .* - [F,L]

# Rewrite php files to be accessible without the .php extension
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
