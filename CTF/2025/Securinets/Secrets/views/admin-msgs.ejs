<!DOCTYPE html>
<html>
<head>
  <title>Admin - Msgs</title>
</head>
<body>
  <h1>All Msgs</h1>

  <form method="POST" action="/admin/msgs">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="filterBy">Filter by:</label>
    <select name="filterBy" id="filterBy">
      <option value="msg" <%= filterBy === "msg" ? "selected" : "" %>>Message</option>
      <option value="type" <%= filterBy === "type" ? "selected" : "" %>>Type</option>
    </select>
  
    <input type="text" name="keyword" placeholder="Keyword" value="<%= keyword || "" %>">
    <button type="submit">Filter</button>
    <a href="/admin/msgs">Clear</a>
  </form>
  
  <br>
  <table border="1" cellpadding="5">
    <thead>
      <tr>
        <th>ID</th>
        <th>User</th>
        <th>Message</th>
        <th>Type</th>
        <th>Created At</th>
      </tr>
    </thead>
    <tbody>
      <% msgs.forEach(msg => { %>
        <tr>
          <td><%= msg.id %></td>
          <td><%= msg.username %></td>
          <td><%= msg.msg %></td>
          <td><%= msg.type %></td>
          <td><%= msg.createdAt %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
