<!DOCTYPE html>
<html>
<head>
  <title>Send msg</title>
</head>
<body>
  <h1>Send msg</h1>

  <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

  <form id="Form">
    <label>Message:</label><br>
    <input type="text" name="msg" required><br><br>
    <button type="submit">Submit</button>
  </form>

  <p id="message"></p>

  <script>
    const form = document.getElementById("Form");
    const messageEl = document.getElementById("message");
    const csrfToken = document.getElementById("csrfToken").value;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = form.msg.value;

      try {
        const res = await fetch("/msg", {
          method: "POST",
          headers: { 
            "Content-Type": "application/json",
            "CSRF-Token": csrfToken // send CSRF token
          },
          credentials: "include",
          body: JSON.stringify({ msg })
        });

        const json = await res.json();
        if (res.ok) {
          messageEl.innerText = json.message;
          form.reset();
        } else {
          messageEl.innerText = json.error || "Failed to submit msg";
        }
      } catch (err) {
        messageEl.innerText = "Error: " + err.message;
      }
    });
  </script>
</body>
</html>
