<!DOCTYPE html>
<html>
<head>
  <title>All Users</title>
</head>
<body>
  <h1>All Users</h1>

  <table border="1" cellpadding="5">
    <thead>
      <tr>
        <th>ID</th>
        <th>Username</th>
        <th>Role</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.username %></td>
          <td><%= user.role %></td>
          <td><%= user.description %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <script>
    window.addEventListener("DOMContentLoaded", () => {
      fetch("/log", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "CSRF-Token": "<%= csrfToken %>" 
        },
        credentials: "include", 
        body: JSON.stringify({
          userId: "<%= user.id %>",
          action: "Visited users page",
        })
      })
      .then(res => res.json())
      .then(json => console.log("Log created:", json))
      .catch(err => console.error("Log error:", err));
    });
  </script>
</body>
</html>
